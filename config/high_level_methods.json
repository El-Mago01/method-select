{
    "parameters": [
        {
            "id": "project_type",
            "question": "What type of project is it?",
            "type": "select",
            "options": [
                "HW-design",
                "SW-design",
                "Validation services",
                "Research study",
                "Internal improvement"
            ]
        },
        {
            "id": "team_size",
            "question": "How many core team members are involved in the project (including project manager)?",
            "type": "number",
            "min": 1,
            "max": 100
        },
        {
            "id": "knowledge_of_technology",
            "question": "How well is the technology known?",
            "type": "select",
            "options": [
                "low",
                "medium",
                "high"
            ]
        },
        {
            "id": "knowledge_of_customer_requirements",
            "question": "How well do we know the customer requirements?",
            "type": "select",
            "options": [
                "low",
                "medium",
                "high"
            ]
        },
        {
            "id": "scope_defined",
            "question": "Do you have the scope of the project clearly defined with the sponsor/stakeholders",
            "type": "select",
            "options": [
                "no",
                "somewhat",
                "yes"
            ]
        },
        {
            "id": "scope_agreed",
            "question": "Was there a handshake on the scope of the project with the sponsor(s)/stakeholder(s)",
            "type": "select",
            "options": [
                "no",
                "somewhat",
                "yes"
            ]
        }
    ],
    "rules": [
        {
            "knowledge_of_technology": "medium",
            "knowledge_of_customer_requirements": "medium",
            "method": "lean_methods"
        },
        {
            "knowledge_of_technology": [
                "low",
                "medium"
            ],
            "knowledge_of_customer_requirements": null,
            "method": "agile_methods"
        },
        {
            "knowledge_of_technology": null,
            "knowledge_of_customer_requirements": [
                "low",
                "medium"
            ],
            "method": "agile_methods"
        },
        {
            "knowledge_of_technology": "low",
            "knowledge_of_customer_requirements": "medium",
            "method": "agile_methods"
        },
        {
            "knowledge_of_technology": "high",
            "knowledge_of_customer_requirements": "high",
            "method": "classical_project_methods"
        },
        {
            "knowledge_of_technology": "high",
            "knowledge_of_customer_requirements": "medium",
            "method": "lean_methods"
        },
        {
            "knowledge_of_technology": "medium",
            "knowledge_of_customer_requirements": "high",
            "method": "lean_methods"
        },
        {
            "project_type": "SW-design",
            "team_size": {
                "min": 3
            },
            "method": "agile_methods"
        },
        {
            "project_type": "HW-design",
